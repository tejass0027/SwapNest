SECRET_KEY=dev-secret-change-me
DATABASE_PATH=./marketplace.db

# Leave STRIPE_SECRET_KEY empty to run in demo mode (purchases complete
# instantly, no money moves). Set test keys to exercise the live flow.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PLATFORM_FEE_PERCENT=5
ENABLE_SOCIAL_ACCOUNTS=true
SITE_NAME=SwapNest

# Leave false for local http:// dev — browsers drop "Secure" cookies on
# a non-HTTPS origin, which would silently break every login. Set to
# true once the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
